# ─── Database ────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@host:5432/dbname
PGDATABASE=dbname
PGHOST=host
PGPORT=5432
PGUSER=user
PGPASSWORD=password

# ─── Clerk Authentication ─────────────────────────────────────────────────────
# Get keys from https://dashboard.clerk.com
CLERK_SECRET_KEY=sk_live_...
VITE_CLERK_PUBLISHABLE_KEY=pk_live_...
CLERK_PUBLISHABLE_KEY=pk_live_...

# ─── Developer Portal ─────────────────────────────────────────────────────────
# Strong password to access /api/dev admin panel — change this before deploying
DEV_PORTAL_PASSWORD=change-me-strong-password

# ─── Security Secrets ─────────────────────────────────────────────────────────
# HMAC secret for desktop license tokens — must be changed in production
LICENSE_SECRET=change-me-license-secret-min-32-chars

# Salt appended to employee PINs before hashing — change before first use
PIN_SALT=change-me-pos-salt-2025

# ─── Session ──────────────────────────────────────────────────────────────────
SESSION_SECRET=random-32-character-string-here

# ─── App ──────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=8080

# ─── ZATCA Phase 2 — e-Invoicing (فاتورة) ────────────────────────────────────
# Only required when config.phase = "phase2" and ZATCA reporting is enabled.
# Obtain credentials from the ZATCA Fatoorah portal (https://fatoora.zatca.gov.sa).
#
# CSID issued after onboarding (Compliance CSID for sandbox, PCSID for production):
ZATCA_CSID=

# Secret accompanying the CSID:
ZATCA_CSID_SECRET=

# ECDSA P-256 private key in PEM format — replace newlines with \n:
# openssl ecparam -name prime256v1 -genkey -noout | openssl pkcs8 -topk8 -nocrypt
ZATCA_PRIVATE_KEY=

# Base64-encoded X.509 certificate (no PEM headers, no whitespace):
ZATCA_CERTIFICATE=

# Target environment: sandbox | simulation | production
ZATCA_ENVIRONMENT=sandbox
